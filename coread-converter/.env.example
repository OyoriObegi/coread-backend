# Free-first deployment: Firebase Spark + Supabase Free + Render Free.
FIREBASE_PROJECT_ID=coread-9bc50
FIREBASE_SERVICE_ACCOUNT_JSON=
BOOK_STORAGE_PROVIDER=supabase
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SECRET_KEY=
# Optional legacy service_role JWT if your dashboard uses legacy keys.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=coread-books
# Only needed if you explicitly switch to Firebase Storage later (requires Blaze).
FIREBASE_STORAGE_BUCKET=
# Use your free Render hostname; no purchased domain is required.
APP_LINK_ORIGIN=https://YOUR_SERVICE.onrender.com
ANDROID_CERT_SHA256=
# Optional AI. Leave unset to disable; no paid models are configured by default.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Leave SMTP unset on Render Free. Share invitation links in the app.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
